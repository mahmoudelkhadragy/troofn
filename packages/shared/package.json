{
  "name": "@troofn/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Types, enums and constants shared by the Troofn API and dashboard",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "tsc --noEmit",
    "test": "echo \"@troofn/shared: no tests yet\""
  },
  "devDependencies": {
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3"
  }
}
