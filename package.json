{
  "name": "troofn",
  "version": "0.1.0",
  "private": true,
  "description": "Troofn Business Gate — NestJS API + Angular dashboard monorepo",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.22.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm build:shared && pnpm --parallel --filter @troofn/api --filter @troofn/dashboard dev",
    "dev:api": "pnpm --filter @troofn/api dev",
    "dev:dashboard": "pnpm --filter @troofn/dashboard dev",
    "build": "pnpm build:shared && pnpm --filter @troofn/api --filter @troofn/dashboard build",
    "build:shared": "pnpm --filter @troofn/shared build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @troofn/api test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:tools": "docker compose --profile tools up -d",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9"
  }
}
