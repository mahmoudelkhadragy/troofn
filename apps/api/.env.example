# ── App ──────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed origins (dashboard, etc.)
CORS_ORIGINS=http://localhost:4200

# ── Database (matches docker-compose.yml) ───────
DATABASE_URL="postgresql://troofn:troofn@localhost:5433/troofn?schema=public"

# ── Auth (used from the auth phase) ─────────────
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters
JWT_REFRESH_EXPIRES_IN=7d

# ── Rate limiting ───────────────────────────────
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# ── Logging: fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# ── Seed (dev / test only) ──────────────────────
# Password for every demo user created by `pnpm db:seed`. Not used in production.
SEED_DEFAULT_PASSWORD=Troofn@2026
