# ── App ──────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed origins (dashboard, etc.)
CORS_ORIGINS=http://localhost:4200

# ── Database (matches docker-compose.yml) ───────
DATABASE_URL="postgresql://troofn:troofn@localhost:5433/troofn?schema=public"

# ── Auth ────────────────────────────────────────
# Access token: a short-lived JWT sent as "Authorization: Bearer <token>".
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters
JWT_ACCESS_TTL_SECONDS=900
# Refresh token: opaque, rotated on every use; the DB stores only an HMAC of it keyed with this secret.
REFRESH_TOKEN_SECRET=change-me-refresh-secret-min-32-characters
REFRESH_TOKEN_TTL_DAYS=7
# Account lockout and the per-IP limit on /auth/login and /auth/refresh (requests per minute).
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_LOGIN_RATE_LIMIT=5
# ── Rate limiting ───────────────────────────────
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# ── Logging: fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# ── Seed (dev / test only) ──────────────────────
# Password for every demo user created by `pnpm db:seed`. Not used in production.
SEED_DEFAULT_PASSWORD=Troofn@2026
